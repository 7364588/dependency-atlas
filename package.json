{
  "name": "dependency-atlas",
  "version": "0.1.0",
  "description": "Offline, evidence-linked dependency reviews between Git revisions",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "dependency-atlas": "dist/cli.js" },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "docs/preview.png"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "demo": "tsc -p tsconfig.json && node scripts/demo.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": { "typescript": "5.9.3" },
  "devDependencies": { "@types/node": "22.20.4" }
}
